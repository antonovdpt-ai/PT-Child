# Non-secret configuration for /etc/fizira/backup.env.
# S3 access keys belong in root's rclone.conf, not in this file or Git.

FIZIRA_PROJECT_ROOT=/root/supabase-project
FIZIRA_BACKUP_ROOT=/root/fizira-backups
FIZIRA_ENCRYPTED_ROOT=/root/fizira-encrypted-backups
FIZIRA_DB_CONTAINER=supabase-db

# Name of the rclone remote (without a trailing colon) and its object prefix.
FIZIRA_RCLONE_REMOTE=fizira-offsite
FIZIRA_RCLONE_PATH=fizira-production/backups

FIZIRA_BACKUP_PASSPHRASE_FILE=/etc/fizira/backup-passphrase
FIZIRA_LOCAL_RETENTION_DAYS=7
FIZIRA_VERIFY_RESTORE=1
FIZIRA_DELETE_RAW_AFTER_UPLOAD=1
FIZIRA_PBKDF2_ITERATIONS=600000
